{
  "name": "figma-atlas-import-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build && cargo build --manifest-path ../local-helper/Cargo.toml --locked",
    "test": "node --test tests/*.test.mjs",
    "pretest:browser": "npm run build && cargo build --manifest-path ../local-helper/Cargo.toml --locked",
    "test:all": "npm run typecheck && npm test && npm run test:browser",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.120.0",
    "@playwright/test": "^1.58.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
